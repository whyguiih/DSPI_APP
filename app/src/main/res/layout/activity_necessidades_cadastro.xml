<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/glassContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="24dp"
        android:background="@drawable/bg_glass"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Título da Página -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastrar Nova Necessidade"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/neo_sans"
            app:layout_constraintTop_toBottomOf="@id/btnBack"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <!-- Campo: Nome da Necessidade -->
        <EditText
            android:id="@+id/inputNomeNecessidade"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input_glass"
            android:hint="Nome da necessidade"
            android:textColorHint="#B3FFFFFF"
            android:textColor="#FFFFFF"
            android:paddingHorizontal="20dp"
            android:inputType="text"
            android:fontFamily="@font/neo_sans"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            android:layout_marginTop="32dp"/>

        <!-- Campo: Descrição -->
        <EditText
            android:id="@+id/inputDescricaoNecessidade"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_input_glass"
            android:hint="Descreva os detalhes da necessidade..."
            android:textColorHint="#B3FFFFFF"
            android:textColor="#FFFFFF"
            android:padding="20dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="5"
            android:fontFamily="@font/neo_sans"
            app:layout_constraintTop_toBottomOf="@id/inputNomeNecessidade"
            android:layout_marginTop="16dp"/>

        <!-- Botão Enviar -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSalvarNecessidade"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/bg_button_login"
            android:text="SALVAR NECESSIDADE"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="@font/neo_sans"
            app:layout_constraintTop_toBottomOf="@id/inputDescricaoNecessidade"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>