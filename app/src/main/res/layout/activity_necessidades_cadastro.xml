<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#FFFFFF"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="48dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/glassContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:padding="28dp"
                android:background="@drawable/bg_glass"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/iconNecessidade"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_necessidades"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nova Necessidade"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/neo_sans"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/iconNecessidade"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/labelNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="O que sua empresa precisa?"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/neo_sans"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/tvTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/inputNomeNecessidade"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Ex: Desenvolvimento de App"
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="20dp"
                    android:inputType="text"
                    android:fontFamily="@font/neo_sans"
                    app:layout_constraintTop_toBottomOf="@id/labelNome" />

                <TextView
                    android:id="@+id/labelDescricao"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Detalhes da demanda"
                    android:textColor="#B3FFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/neo_sans"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/inputNomeNecessidade"
                    app:layout_constraintStart_toStartOf="parent" />

                <EditText
                    android:id="@+id/inputDescricaoNecessidade"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_glass"
                    android:hint="Descreva aqui os detalhes técnicos ou o problema a ser resolvido..."
                    android:textColorHint="#66FFFFFF"
                    android:textColor="#FFFFFF"
                    android:padding="20dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine"
                    android:lines="5"
                    android:fontFamily="@font/neo_sans"
                    app:layout_constraintTop_toBottomOf="@id/labelDescricao" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSalvarNecessidade"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginTop="40dp"
                    android:background="@drawable/bg_button_login"
                    android:text="PUBLICAR NECESSIDADE"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:fontFamily="@font/neo_sans"
                    android:textSize="16sp"
                    app:layout_constraintTop_toBottomOf="@id/inputDescricaoNecessidade"
                    android:layout_marginBottom="8dp"
                    app:layout_constraintBottom_toBottomOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>